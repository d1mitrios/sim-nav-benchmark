#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "my_custom_robot"
    doc = """Robot model generated by the Isaac Sim URDF importer."""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "my_custom_robot" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </my_custom_robot/Physics/root_joint>,
        </my_custom_robot/Physics/left_wheel_joint>,
        </my_custom_robot/Physics/right_wheel_joint>,
        </my_custom_robot/Physics/caster_joint>,
        </my_custom_robot/Physics/lidar_joint>,
        </my_custom_robot/Physics/camera_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </my_custom_robot/Geometry/chassis>,
        </my_custom_robot/Geometry/chassis/left_wheel>,
        </my_custom_robot/Geometry/chassis/right_wheel>,
        </my_custom_robot/Geometry/chassis/caster_wheel>,
        </my_custom_robot/Geometry/chassis/lidar_link>,
        </my_custom_robot/Geometry/chassis/camera_link>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "chassis" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "left_wheel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "right_wheel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "caster_wheel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "lidar_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "camera_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "caster_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "lidar_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "camera_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

