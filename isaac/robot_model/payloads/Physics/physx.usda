#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "my_custom_robot"
    doc = """Robot model generated by the Isaac Sim URDF importer."""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "my_custom_robot"
{
    over "Physics"
    {
        over "left_wheel_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "right_wheel_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

