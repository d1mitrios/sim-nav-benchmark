#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (5, 5, 5)
                double3 target = (-3.978038609631085e-8, -3.978038431995401e-8, 7.956077041626486e-8)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        string creator = "URDF USD Converter v0.1.3"
        dictionary omni_layer = {
            string authoring_layer = "./robot.usda"
            dictionary locked = {
            }
            dictionary muteness = {
            }
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "my_custom_robot"
    doc = "Benchmark scene: robot, arena and walkers. The robot model is in robot_model/."
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Xform "my_custom_robot" (
    prepend references = @./robot_model/payloads/base.usda@
    variants = {
        string Physics = "physx"
    }
    append variantSets = "Physics"
)
{
    double3 xformOp:rotateZYX
    double3 xformOp:scale
    double3 xformOp:translate = (0, 0, 0.1)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZYX", "xformOp:scale"]

    over "Geometry"
    {
        over "chassis"
        {
            vector3f physics:angularVelocity = (0.0026733885, -0.0017519415, 0.0003628079)
            vector3f physics:velocity = (-0.0000096526755, 0.000008150964, -0.000009901778)
            quatf xformOp:orient = (1, -1.894995e-9, 2.1271165e-7, 0.0000023536388)
            float3 xformOp:scale = (1, 1, 1)
            float3 xformOp:translate = (-5.2749307e-8, 1.8655038e-8, 8.940697e-9)
            token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "left_wheel" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </PhysicsMaterials/WheelGrip> (
                    bindMaterialAs = "strongerThanDescendants"
                )
                vector3f physics:angularVelocity = (0.003130371, -100.26541, 0.00036318784)
                vector3f physics:velocity = (-0.000010760806, 0.000007517739, -0.0000047941458)
                quatf xformOp:orient = (-0.3465056, -0.0000020740467, 0.9380479, -8.147079e-7)
                double3 xformOp:translate = (-0.10000084340572357, 0.17499940097332, -0.04999995976686478)
            }

            over "right_wheel" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                string isaac:nameOverride (
                    displayName = "Name Override"
                )
                rel material:binding:physics = </PhysicsMaterials/WheelGrip> (
                    bindMaterialAs = "strongerThanDescendants"
                )
                vector3f physics:angularVelocity = (0.002216382, 100.26714, 0.000362428)
                vector3f physics:velocity = (-0.000008544541, 0.0000075177495, -0.000021124884)
                quatf xformOp:orient = (-0.49384305, -0.0000019222714, 0.86955106, -0.000001160244)
                double3 xformOp:translate = (-0.09999918937683105, -0.1750003844499588, -0.04999995976686478)
            }

            over "caster_wheel" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </PhysicsMaterials/CasterSlip> (
                    bindMaterialAs = "strongerThanDescendants"
                )
                vector3f physics:angularVelocity = (0.0026733885, -0.0017519415, 0.0003628079)
                vector3f physics:velocity = (-0.000008888249, 0.000010267282, -0.0000053151743)
                quatf xformOp:orient = (1, -1.894995e-9, 2.1271165e-7, 0.0000023536388)
                double3 xformOp:translate = (0.1499999463558197, 7.058129654069489e-7, -0.07500004768371582)
            }

            over "lidar_link"
            {
                vector3f physics:angularVelocity = (0.0026733885, -0.0017519415, 0.0003628079)
                vector3f physics:velocity = (-0.000013474818, 0.0000023185382, -0.000009901776)
                quatf xformOp:orient = (1, -1.894995e-9, 2.1271165e-7, 0.0000023536388)
                double3 xformOp:translate = (3.190700326172191e-8, 2.843254520712435e-10, 0.07499997317790985)
            }

            over "camera_link"
            {
                vector3f physics:angularVelocity = (0.0026733885, -0.0017519415, 0.0003628079)
                vector3f physics:velocity = (-0.000011181536, 0.0000071477584, -0.000003480533)
                quatf xformOp:orient = (1, -1.894995e-9, 2.1271165e-7, 0.0000023536388)
                double3 xformOp:translate = (0.2099999487400055, 9.885360441330704e-7, -8.940696716308594e-8)

                def Camera "robot_camera" (
                    prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
                )
                {
                    float2 clippingRange = (0.05, 10000)
                    float exposure:fStop = 5
                    float exposure:responsivity = 1.1026709
                    float exposure:time = 0.02
                    float focalLength = 18.14756
                    custom float omni:sensor:tickRate = 5
                    quatf xformOp:orient = (0.5, 0.5, -0.5, -0.5)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                }
            }
        }
    }

    over "Physics"
    {
        over "left_wheel_joint"
        {
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:maxForce = 1000000
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetVelocity = 0
            float state:angular:physics:position = 220.54744
            float state:angular:physics:velocity = -100.2637
        }

        over "right_wheel_joint"
        {
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:maxForce = 1000000
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetVelocity = 0
            float state:angular:physics:position = -120.81306
            float state:angular:physics:velocity = 100.26894
        }

        over "root_joint" (
            active = false
        )
        {
            bool[] isaac:actuator (
                displayName = "Actuator"
            )
            string isaac:NameOverride (
                displayName = "Joint Name Override"
            )
            token[] isaac:physics:DofOffsetOpOrder (
                displayName = "Dof Offset Op Order"
            )
        }
    }
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./robot_model/payloads/Physics/mujoco.usda@
        ) {

        }
        "none" {

        }
        "physics" (
            prepend payload = @./robot_model/payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./robot_model/payloads/Physics/physx.usda@
        ) {

        }
    }
}

over "Flattened_Prototype_11"
{
    def Shader "PreviewSurface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </Flattened_Prototype_11.inputs:diffuseColor>
        float inputs:metallic.connect = </Flattened_Prototype_11.inputs:metallic>
        float inputs:opacity.connect = </Flattened_Prototype_11.inputs:opacity>
        float inputs:roughness.connect = </Flattened_Prototype_11.inputs:roughness>
        token outputs:displacement
        token outputs:surface
    }
}

